{
  "name": "megnivolim",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env prisma/seed.mjs",
    "electron:prep": "npm run build && node scripts/prepare-standalone.mjs && node --env-file=.env scripts/build-template-db.mjs && node --env-file=.env scripts/build-runtime-env.mjs",
    "electron:dist": "npm run electron:prep && electron-builder --win"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "groq-sdk": "^1.5.0",
    "jose": "^6.2.8",
    "next": "16.3.0",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.megnivolim.desktop",
    "productName": "המגניבולים",
    "asar": true,
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "next-standalone",
        "to": "next-standalone"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "megnivolim-setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
