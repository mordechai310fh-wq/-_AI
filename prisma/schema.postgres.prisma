// Used only for the public (Render) deployment - see render.yaml.
// Local dev and the Electron desktop app use prisma/schema.prisma (SQLite),
// which needs no external database. Keep both schemas' models in sync.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  isOwner      Boolean  @default(false)
  hasAccess    Boolean  @default(false)
  bannedUntil  DateTime?
  banReason    String?
  avatarUrl    String?
  coins             Int      @default(0)
  gamePoints        Int      @default(0)
  postCredits       Int      @default(0)
  juniorChatCredits Int      @default(0)
  lastSeenMessageAt DateTime?
  createdAt    DateTime @default(now())

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  aiMessages    AiMessage[]
  adminMessages AdminMessage[]
  gameScores    GameScore[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  imageUrl  String?
  videoUrl  String?
  audioUrl  String?
  gameCode     String?
  gameType     String?
  gameControls String?
  createdAt    DateTime @default(now())

  likes     Like[]
  comments  Comment[]
  scores    GameScore[]
}

model GameScore {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  tier      String   @default("full")
  createdAt DateTime @default(now())
}

model AdminMessage {
  id           String   @id @default(cuid())
  targetUserId String?
  targetUser   User?    @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  text         String
  createdAt    DateTime @default(now())
}
