generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  isOwner      Boolean  @default(false)
  hasAccess    Boolean  @default(false)
  bannedUntil  DateTime?
  banReason    String?
  avatarUrl    String?
  coins             Int      @default(0)
  gamePoints        Int      @default(0) // earned from /point games, exchanged for coins in the shop
  postCredits       Int      @default(0) // lets a user without full access post one video
  juniorChatCredits Int      @default(0) // messages left with the limited AI chat
  lastSeenMessageAt DateTime? // admin messages (global/private) created after this are still "unread"
  createdAt    DateTime @default(now())

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  aiMessages    AiMessage[]
  adminMessages AdminMessage[]
  gameScores    GameScore[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  imageUrl  String?
  videoUrl  String?
  audioUrl  String?
  gameCode     String?
  gameType     String?
  gameControls String?
  createdAt    DateTime @default(now())

  likes     Like[]
  comments  Comment[]
  scores    GameScore[]
}

model GameScore {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      @default(0) // best score this user got on this specific game
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  tier      String   @default("full") // "full" (מגניב) or "junior" (מגניב ג'וניור) - kept as separate conversations
  createdAt DateTime @default(now())
}

model AdminMessage {
  id           String   @id @default(cuid())
  targetUserId String? // null = global broadcast to everyone
  targetUser   User?    @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  text         String
  createdAt    DateTime @default(now())
}
